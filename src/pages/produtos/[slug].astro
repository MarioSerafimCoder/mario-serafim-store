---
import type { GetStaticPaths } from 'astro';
import ProductDetail from '../../components/ProductDetail.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProducts, type Product } from '../../lib/shop';
import { toProduct, slugPattern, type ProductRow } from '../../../worker/catalog';

export const getStaticPaths = (async () => {
  const products = await getPublicProducts();
  return products.map((product) => {
    const others = products.filter(({ id }) => id !== product.id);
    const related = [
      ...others.filter(({ data }) => data.category === product.data.category),
      ...others.filter(({ data }) => data.category !== product.data.category),
    ].slice(0, 3);
    return { params: { slug: product.data.slug }, props: { product, related } };
  });
}) satisfies GetStaticPaths;

interface Props { product?: Product; related?: Product[] }
let { product, related = [] } = Astro.props;
const db = Astro.locals.storeDB;
const slug = Astro.params.slug ?? '';
if (db && slug.length <= 100 && slugPattern.test(slug)) {
  const row = await db.prepare(`
    SELECT p.* FROM product_slugs s JOIN products p ON s.sku=p.sku
    WHERE s.slug=? AND p.status IN ('published','coming_soon')
  `).bind(slug).first<ProductRow>();
  if (row) {
    if (row.slug !== slug) return Astro.redirect('/produtos/' + row.slug + '/', 301);
    product = toProduct(row);
    const others = await db.prepare(`
      SELECT * FROM products WHERE status IN ('published','coming_soon') AND sku<>?
      ORDER BY (category=?) DESC,name COLLATE NOCASE LIMIT 3
    `).bind(row.sku,row.category).all<ProductRow>();
    related = others.results.map(toProduct);
  }
}
if (!product) Astro.response.status = 404;
---
{product ? <ProductDetail product={product} related={related} /> :
  <BaseLayout title="Produto não encontrado" noindex>
    <section class="page-intro"><h1 class="display">Produto não encontrado.</h1><a class="action" href="/produtos/">Ver catálogo</a></section>
  </BaseLayout>}
