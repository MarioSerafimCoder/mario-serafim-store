---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductTile from '../../components/ProductTile.astro';
import { formatDate, formatPrice } from '../../lib/format';
import { getPublicProducts, renderProductDescription, type Product } from '../../lib/shop';

export const getStaticPaths = (async () => {
  const products = await getPublicProducts();
  return products.map((product) => {
    const others = products.filter(({ id }) => id !== product.id);
    const related = [
      ...others.filter(({ data }) => data.category === product.data.category),
      ...others.filter(({ data }) => data.category !== product.data.category),
    ].slice(0, 3);
    return { params: { slug: product.data.slug }, props: { product, related } };
  });
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const { category, formats, images, includes, license, name, priceCents, requirements,
  sku, status, summary, updatedAt, version } = product.data;
const { Content, headings } = await renderProductDescription(product);
const faq = headings.find(({ text }) => text.toLocaleLowerCase('pt-BR') === 'perguntas frequentes');
---

<BaseLayout title={name} description={summary} image={images[0]}>
  <nav aria-label="Localização" class="product-breadcrumb">
    <a href="/produtos/" class="text-link tap"><span aria-hidden="true">←</span> Catálogo</a>
    <span aria-hidden="true">/</span><span>{category}</span>
  </nav>

  <article>
    <div class="product-layout">
      <header class="product-intro">
        <p class="eyebrow">Produto digital · {category}</p>
        <h1 class="display">{name}</h1>
        <p class="lede">{summary}</p>
        <div class="purchase-panel">
          {status === 'coming_soon'
            ? <p class="eyebrow status-label">Em breve</p>
            : <p class="product-price">{formatPrice(priceCents)}</p>}
          <p class="purchase-state"><span class="signal" aria-hidden="true"></span>Compra indisponível nesta etapa.</p>
        </div>
      </header>

      <ProductGallery images={images} />

      <div class="product-details">
        <section class="detail-block article">
          <h2>Conteúdo incluído</h2>
          <ul>{includes.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section class="detail-block">
          <h2>Formatos e compatibilidade</h2>
          <dl class="spec-list">
            <div><dt>Formatos</dt><dd>{formats.join(', ')}</dd></div>
            <div><dt>Requisitos de software</dt><dd>{requirements.length > 0 ? requirements.join(', ') : 'Não informados'}</dd></div>
          </dl>
        </section>
      </div>
    </div>

    <div class="store-section product-more">
      <section class="detail-block article" aria-labelledby="product-description">
        <h2 id="product-description">Descrição</h2>
        {faq && <a class="text-link tap" href={`#${faq.slug}`}>Perguntas frequentes</a>}
        <Content />
      </section>

      <div class="product-disclosures">
        <details class="detail-block">
          <summary class="tap">Licença de uso</summary>
          <div class="article">
            <p><strong>{license.type}</strong></p>
            <p>{license.summary}</p>
            <a href="/licencas/" class="text-link tap">Informações de licenciamento</a>
          </div>
        </details>
        <details class="detail-block">
          <summary class="tap">Versão e atualização</summary>
          <dl class="spec-list">
            <div><dt>Versão</dt><dd>{version}</dd></div>
            <div><dt>Atualização</dt><dd><time datetime={updatedAt}>{formatDate(updatedAt)}</time></dd></div>
            <div><dt>SKU</dt><dd>{sku}</dd></div>
          </dl>
        </details>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="store-section" aria-labelledby="related">
      <div class="section-heading"><h2 id="related" class="section-title">Produtos relacionados</h2></div>
      <ul class="product-grid">{related.map((item) => <li><ProductTile product={item} /></li>)}</ul>
    </section>
  )}
</BaseLayout>
