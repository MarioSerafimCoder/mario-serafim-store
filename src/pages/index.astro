---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductTile from '../components/ProductTile.astro';
import { getPublicProducts } from '../lib/shop';

const products = await getPublicProducts();
const featured = products.filter(({ data }) => data.featured).slice(0, 3);
const categories = [...new Set(products.map(({ data }) => data.category))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="signal"></span> Mário Serafim / Loja digital</p>
      <h1 class="display">Recursos digitais<br />para <em>criar.</em></h1>
      <p class="lede">Arquivos de design para desenvolver ideias, experimentar formas e dar acabamento aos seus projetos.</p>
      <a class="action" href="/produtos/">Explorar catálogo <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <span class="art-caption">MÁRIO SERAFIM STORE <span>FIG. 01</span></span>
      <svg viewBox="0 0 520 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ribbon" x1="92" y1="75" x2="453" y2="342" gradientUnits="userSpaceOnUse">
            <stop stop-color="#6f121b" />
            <stop offset=".33" stop-color="#ff5344" />
            <stop offset=".65" stop-color="#d2292e" />
            <stop offset="1" stop-color="#65111a" />
          </linearGradient>
          <linearGradient id="fold" x1="177" y1="337" x2="370" y2="80" gradientUnits="userSpaceOnUse">
            <stop stop-color="#790e20" />
            <stop offset=".55" stop-color="#e12830" />
            <stop offset="1" stop-color="#ff7964" />
          </linearGradient>
        </defs>
        <g stroke="#3a3231">
          <path d="M0 104C132 33 337 44 520 169M0 156C139 77 319 78 520 204M0 212C139 115 318 109 520 243M0 268C146 155 318 145 520 280M0 324C170 192 342 195 520 316"/>
          <circle cx="266" cy="201" r="151" stroke-dasharray="2 5" />
          <path d="M266 24v352M36 201h460" stroke-dasharray="3 7" />
        </g>
        <path d="M105 241C116 141 185 77 313 62c75-9 138 18 133 69-4 52-79 105-187 134-57 16-115 12-154-24Zm34-28c41 21 82 19 134 5 83-22 147-64 149-89 2-28-57-35-112-27-84 12-145 52-171 111Z" fill="url(#ribbon)" fill-rule="evenodd" />
        <path d="M119 219c-31 55-24 110 20 127 66 27 196-39 249-121 31-48 39-88 25-112 4 34-26 75-62 110-62 60-155 106-195 94-27-8-28-39-8-79l-29-19Z" fill="url(#fold)" />
        <path d="M127 216C165 135 232 101 311 90c54-8 92-1 108 12M143 326c48 28 157-32 224-103" stroke="#ff9b83" stroke-opacity=".5" />
        <circle cx="266" cy="201" r="4" fill="#e64843" />
      </svg>
      <span class="art-caption">ESTUDO DE FORMA <span>01 / 01</span></span>
    </div>
  </section>

  <section class="editorial-section" aria-labelledby="featured">
    <div class="section-heading">
      <div><p class="eyebrow">01 / Catálogo</p><h2 id="featured" class="section-title">Em destaque</h2></div>
      <a class="text-link tap" href="/produtos/">Ver todos os produtos <span aria-hidden="true">↗</span></a>
    </div>
    {featured.length > 0 ? (
      <ul class="product-grid">{featured.map((product) => <li><ProductTile product={product} /></li>)}</ul>
    ) : (
      <div class="empty-state">
        <p class="eyebrow">Catálogo em preparação</p>
        <p>Os primeiros produtos aparecerão aqui assim que forem anunciados.</p>
      </div>
    )}
  </section>

  <section class="editorial-section" aria-labelledby="categories">
    <p class="eyebrow">02 / Índice</p>
    <h2 id="categories" class="section-title">Categorias</h2>
    {categories.length > 0 ? (
      <ul class="index-list">{categories.map((category) => (
        <li><a href={`/produtos/?categoria=${encodeURIComponent(category)}`}>{category}<span aria-hidden="true">↗</span></a></li>
      ))}</ul>
    ) : <p class="lede">As categorias serão exibidas à medida que o catálogo ganhar produtos.</p>}
  </section>

  <section class="editorial-section editorial-pair" aria-labelledby="process">
    <div><p class="eyebrow">03 / Processo</p><h2 id="process" class="section-title">Do estudo ao arquivo.</h2></div>
    <div class="article">
      <p>Um recurso digital começa com uma pergunta de projeto. Testar sua aplicação, organizar os arquivos e explicar como usá-los são partes do mesmo trabalho.</p>
      <p>Nas páginas dos produtos, as prévias, os formatos e as condições de uso ajudam a avaliar cada recurso para o seu projeto.</p>
    </div>
  </section>

  <section class="editorial-section editorial-pair" aria-labelledby="author">
    <div><p class="eyebrow">04 / Autoria</p><h2 id="author" class="section-title">Mário Serafim</h2></div>
    <div class="article">
      <p>Diretor de arte em Fortaleza, com atuação em identidade visual, branding e experiências digitais.</p>
      <a class="text-link tap" href="/sobre/">Sobre o autor <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
