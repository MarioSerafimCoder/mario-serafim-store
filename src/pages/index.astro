---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductTile from '../components/ProductTile.astro';
import { getPublicProducts } from '../lib/shop';
import { getSettings } from '../../worker/catalog';

const db = Astro.locals.storeDB;
const [products, settings] = await Promise.all([getPublicProducts(db), db && getSettings(db)]);
const featured = products.filter(({ data }) => data.featured);
const selection = [...featured, ...products.filter(({ data }) => !data.featured)].slice(0, 5);
const categories = [...new Set(products.map(({ data }) => data.category))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---

<BaseLayout>
  {settings?.announcement && <p class="empty-state" role="status">{settings.announcement}</p>}
  <section class="store-hero">
    <div>
      <p class="eyebrow"><span class="signal" aria-hidden="true"></span> Mário Serafim Store</p>
      <h1 class="display">Recursos digitais <em>para criar.</em></h1>
      <p class="lede">Arquivos de design para experimentar ideias, estruturar projetos e dar acabamento ao seu trabalho.</p>
    </div>
    <a class="action" href="/produtos/">Explorar catálogo <span aria-hidden="true">↗</span></a>
  </section>

  <section class="store-section" aria-labelledby="featured">
    <div class="section-heading">
      <h2 id="featured" class="section-title">{featured.length > 0 ? 'Em destaque' : 'Produtos digitais'}</h2>
      <a class="text-link tap" href="/produtos/">Ver todos os produtos <span aria-hidden="true">↗</span></a>
    </div>
    {selection.length > 0 ? (
      <ul class="product-grid">{selection.map((product) => <li><ProductTile product={product} /></li>)}</ul>
    ) : (
      <div class="empty-state">
        <p class="eyebrow">Catálogo em preparação</p>
        <p>Os primeiros produtos aparecerão aqui assim que forem anunciados.</p>
      </div>
    )}
  </section>

  {categories.length > 0 && (
    <section class="store-section" aria-labelledby="categories">
      <div class="section-heading"><h2 id="categories" class="section-title">Categorias</h2></div>
      <ul class="category-list">{categories.map((category) => (
        <li><a class="tap" href={`/produtos/?categoria=${encodeURIComponent(category)}`}>{category}<span aria-hidden="true">↗</span></a></li>
      ))}</ul>
    </section>
  )}

  <section class="store-section store-benefits" aria-labelledby="benefits">
    <h2 id="benefits" class="section-title">Escolha com clareza.</h2>
    <ul>
      <li><strong>Veja o resultado</strong><p>Explore as prévias para avaliar como o recurso se encaixa no projeto.</p></li>
      <li><strong>Confira a compatibilidade</strong><p>Consulte formatos, conteúdo e requisitos de software antes de escolher.</p></li>
      <li><strong>Entenda a licença</strong><p>Confira as condições de uso na página de cada produto.</p></li>
    </ul>
  </section>

  <section class="store-section store-creator" aria-labelledby="author">
    <div><p class="eyebrow">Quem cria os recursos</p><h2 id="author" class="section-title">Mário Serafim</h2></div>
    <p>Diretor de arte em Fortaleza, com atuação em identidade visual, branding e experiências digitais.</p>
    <a class="text-link tap" href="/sobre/">Sobre o criador <span aria-hidden="true">↗</span></a>
    {settings?.support_url && <a class="text-link tap" href={settings.support_url}>Atendimento <span aria-hidden="true">↗</span></a>}
  </section>
</BaseLayout>
