---
import { site } from '../config/site';

const path = Astro.url.pathname;
const current = (href: string) =>
  path === href ? 'page' : path.startsWith(href) ? 'true' as const : undefined;
---

<header class="site-header">
  <div class="shell masthead">
    <a href="/" class="wordmark tap" aria-current={path === '/' ? 'page' : undefined}>
      <img src="/marca/monograma.png" width="115" height="57" alt="" fetchpriority="high" />
      <span class="wordmark-label"><span>Mário Serafim</span><small>Store</small></span>
    </a>
    <nav aria-label="Navegação principal">
      {site.nav.map((item) => <a href={item.href} aria-current={current(item.href)} class="tap">{item.label}</a>)}
    </nav>
    <button type="button" class="theme-switch" id="theme-switch" hidden>
      <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="7.2" stroke="currentColor" stroke-width="1.5" />
        <path d="M10 2.8a7.2 7.2 0 0 1 0 14.4Z" fill="currentColor" />
      </svg>
      <span>Tema</span>
    </button>
  </div>
</header>
