---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGallery from './ProductGallery.astro';
import CheckoutAction from './CheckoutAction.astro';
import ProductTile from './ProductTile.astro';
import { formatDate, formatPrice } from '../lib/format';
import { isCatalogProduct, renderProductDescription, type Product } from '../lib/shop';
import { richText } from '../../worker/rich-text';

interface Props { product: Product; related: Product[]; preview?: boolean }
const { product, related, preview = false } = Astro.props;
const { category, formats, images, includes, license, name, priceCents, requirements, slug,
  sku, status, summary, updatedAt, version } = product.data;
const dynamic = isCatalogProduct(product);
const markdown = dynamic ? undefined : await renderProductDescription(product);
const Content = markdown?.Content;
const faq = markdown?.headings.find(({ text }) => text.toLocaleLowerCase('pt-BR') === 'perguntas frequentes');
const description = dynamic ? richText(product.data.description) : '';
const canOfferCheckout = !preview && status === 'published' && priceCents > 0 && !sku.startsWith('DEMO-') && !slug.startsWith('demo-');
---

<BaseLayout title={name} description={summary} image={images[0]} noindex={preview}>
  <nav aria-label="Localização" class="product-breadcrumb">
    <a href="/produtos/" class="text-link tap"><span aria-hidden="true">←</span> Catálogo</a>
    <span aria-hidden="true">/</span><span>{category}</span>
  </nav>

  <article class="product-page">
    <div class="product-layout">
      <header class="product-intro">
        <p class="eyebrow product-category">{category} <span aria-hidden="true">·</span> Produto digital</p>
        <h1 class="product-title">{name}</h1>
        <p class="lede product-summary">{summary}</p>
        <ul class="product-facts" aria-label="Informações principais">
          {formats.length > 0 && <li><span aria-hidden="true">↳</span><span>{formats.join(', ')}</span></li>}
          {requirements.length > 0 && <li><span aria-hidden="true">⌘</span><span>{requirements.join(', ')}</span></li>}
          {license.type && <li><span aria-hidden="true">◇</span><span>{license.type}</span></li>}
          {version && <li><span aria-hidden="true">#</span><span>Versão {version}</span></li>}
        </ul>
      </header>

      {images.length > 0 && <ProductGallery images={images} />}

      <aside class="purchase-panel" aria-label="Comprar produto">
        <div class="purchase-heading">
          <span class="digital-badge"><span aria-hidden="true">↓</span> Produto digital</span>
          {status === 'coming_soon'
            ? <p class="eyebrow status-label">Em breve</p>
            : <p class="product-price">{formatPrice(priceCents)}</p>}
        </div>
        {canOfferCheckout ? (
          <CheckoutAction sku={sku} name={name} slug={slug} priceCents={priceCents} dynamic={dynamic} />
        ) : (
          <p class="purchase-state"><span class="signal" aria-hidden="true"></span>{status === 'coming_soon' ? 'Este produto ainda não está disponível.' : 'Compra indisponível nesta etapa.'}</p>
        )}
        {canOfferCheckout && <div class="purchase-notes">
          <p><span aria-hidden="true">↗</span> Pagamento processado pelo Mercado Pago quando o checkout estiver disponível.</p>
          <p><span aria-hidden="true">↓</span> O acesso digital é liberado após a confirmação do pagamento.</p>
          <a href="/licencas/" class="text-link tap">Consultar condições de licença</a>
        </div>}
      </aside>

      <div class="product-details">
        {includes.length > 0 && <section class="detail-block" aria-labelledby="included-heading">
          <h2 id="included-heading">O que está incluído</h2>
          <ul class="included-list">{includes.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </section>}

        {(formats.length > 0 || requirements.length > 0 || version || updatedAt || sku) && <section class="detail-block" aria-labelledby="spec-heading">
          <h2 id="spec-heading">Especificações</h2>
          <dl class="spec-list">
            {formats.length > 0 && <div><dt>Formatos</dt><dd>{formats.join(', ')}</dd></div>}
            {requirements.length > 0 && <div><dt>Software necessário</dt><dd>{requirements.join(', ')}</dd></div>}
            {version && <div><dt>Versão</dt><dd>{version}</dd></div>}
            {updatedAt && <div><dt>Atualização</dt><dd><time datetime={updatedAt}>{formatDate(updatedAt)}</time></dd></div>}
            {sku && <div><dt>SKU</dt><dd>{sku}</dd></div>}
          </dl>
        </section>}
      </div>
    </div>

    <div class="store-section product-more">
      <section class="detail-block article product-description" aria-labelledby="product-description">
        <h2 id="product-description">Descrição</h2>
        {faq && <a class="text-link tap faq-jump" href={`#${faq.slug}`}>Perguntas frequentes <span aria-hidden="true">↓</span></a>}
        {Content ? <Content /> : <Fragment set:html={description} />}
      </section>

      <div class="product-disclosures">
        <details class="detail-block" open>
          <summary class="tap">Licença de uso</summary>
          <div class="article disclosure-content">
            {license.type && <p><strong>{license.type}</strong></p>}
            {license.summary && <p>{license.summary}</p>}
            <a href="/licencas/" class="text-link tap">Informações completas de licenciamento</a>
          </div>
        </details>
        <details class="detail-block">
          <summary class="tap">Versão e atualização</summary>
          <dl class="spec-list">
            {version && <div><dt>Versão</dt><dd>{version}</dd></div>}
            {updatedAt && <div><dt>Atualização</dt><dd><time datetime={updatedAt}>{formatDate(updatedAt)}</time></dd></div>}
            <div><dt>SKU</dt><dd>{sku}</dd></div>
          </dl>
        </details>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="store-section" aria-labelledby="related">
      <div class="section-heading"><h2 id="related" class="section-title">Produtos relacionados</h2></div>
      <ul class="product-grid">{related.map((item) => <li><ProductTile product={item} /></li>)}</ul>
    </section>
  )}
</BaseLayout>
