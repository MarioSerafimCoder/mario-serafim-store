---
import { site, storeSupport } from '../config/site';
import { getSettings, type Settings } from '../../worker/catalog';
const year = new Date().getFullYear();
const settings = Astro.locals.storeDB ? await getSettings(Astro.locals.storeDB) as Settings | null : null;
const identityComplete = Boolean(settings?.legal_name && settings.legal_id && settings.legal_address && settings.legal_email);
const officialContact = site.officialContact;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a href="/" class="wordmark tap">
        <img src="/marca/monograma.png" width="115" height="57" alt="" loading="lazy" />
        <span class="wordmark-label"><span>Mário Serafim</span><small>Store</small></span>
      </a>
      <p>Recursos digitais para projetos de design.</p>
    </div>
    <nav aria-label="Loja">
      <h2>Loja</h2>
      {site.footer.store.map((item) => <a href={item.href} class="tap" target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>{item.label}{item.external && <span aria-hidden="true"> ↗</span>}</a>)}
    </nav>
    <nav aria-label="Ajuda">
      <h2>Ajuda</h2>
      {site.footer.help.map((item) => <a href={item.href} class="tap">{item.label}</a>)}
      <a href={storeSupport.whatsapp} class="tap">WhatsApp <span aria-hidden="true">↗</span></a>
      <a href={`mailto:${storeSupport.email}`} class="tap footer-email">{storeSupport.email}</a>
    </nav>
    <nav aria-label="Informações legais">
      <h2>Informações legais</h2>
      {site.footer.legal.map((item) => <a href={item.href} class="tap">{item.label}</a>)}
    </nav>
    <section class="footer-identity" aria-label="Identificação comercial">
      <h2>Identificação</h2>
      <p><strong>{settings?.legal_name || 'Mário Serafim'}</strong></p>
      {identityComplete ? (
        <>
          <p>{settings!.legal_id}</p><p>{settings!.legal_address}</p><p><a href={`mailto:${settings!.legal_email}`}>{settings!.legal_email}</a></p>
          {settings!.legal_phone && <p>{settings!.legal_phone}</p>}
        </>
      ) : (
        <p class="identity-pending">Dados comerciais em atualização.</p>
      )}
      <a class="tap" href={settings?.support_url || officialContact} target={settings?.support_url ? '_blank' : undefined} rel={settings?.support_url ? 'noreferrer' : undefined}>Canal oficial de contato</a>
    </section>
  </div>
  <div class="shell footer-base"><p>© {year} Mário Serafim</p></div>
</footer>

<style>
  .footer-email { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
</style>
