<section class="cookie-notice" aria-label="Cookies e privacidade" data-cookie-notice hidden>
  <strong>Cookies e privacidade</strong>
  <p>Usamos cookies essenciais para compras e pedidos. O carrinho e o tema ficam salvos neste navegador.</p>
  <div class="notice-actions">
    <a class="text-link tap" href="/privacidade/">Política de Privacidade</a>
    <button class="action" type="button" data-cookie-accept>Aceitar e continuar</button>
  </div>
</section>

<script>
  const notice = document.querySelector<HTMLElement>('[data-cookie-notice]');
  const accept = notice?.querySelector<HTMLButtonElement>('[data-cookie-accept]');
  if (notice && accept) {
    const key = 'store-cookie-notice-v1';
    let accepted = false;
    try { accepted = localStorage.getItem(key) === 'accepted'; } catch {}
    notice.hidden = accepted;
    accept.addEventListener('click', () => {
      try { localStorage.setItem(key, 'accepted'); } catch {}
      notice.hidden = true;
    });
  }
</script>

<style>
  .cookie-notice { position: fixed; inset-inline-end: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 40; display: grid; gap: .5rem; width: min(25rem, calc(100% - 2rem)); padding: 1rem; border: 1px solid var(--line); border-radius: .75rem; background: var(--surface); color: var(--ink); box-shadow: 0 8px 24px rgb(0 0 0 / .12); }
  .cookie-notice[hidden] { display: none; }
  p { margin: 0; font-size: .875rem; line-height: 1.5; }
  .notice-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .25rem .75rem; font-size: .8rem; }
  button { min-height: 2.75rem; cursor: pointer; }
</style>
