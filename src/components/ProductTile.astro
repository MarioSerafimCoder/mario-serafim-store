---
import StoreImage from './StoreImage.astro';
import { productUrl, type Product } from '../lib/shop';
import { formatPrice } from '../lib/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { category, formats, images: [cover], name, priceCents, status, summary } = product.data;
---

<article class="product-tile">
  <a href={productUrl(product)} class="tile-link">
    <StoreImage
      image={cover}
      limit={900}
      widths={[300, 600, 900]}
      sizes="(min-width: 58rem) 30vw, (min-width: 42rem) 46vw, 92vw"
      class="tile-image"
    />
    <div class="tile-copy">
      <p class="eyebrow">{category}</p>
      <h3 class="tile-title">{name}</h3>
      <p class="tile-summary">{summary}</p>
      <p class="tile-formats">{formats.slice(0, 3).join(' · ')}{formats.length > 3 && ` · +${formats.length - 3}`}</p>
      <div class="tile-footer">
        <span class:list={['tile-price', status === 'coming_soon' && 'status-label']}>{status === 'coming_soon' ? 'Em breve' : formatPrice(priceCents)}</span>
        <span class="tile-cta">Ver produto <span aria-hidden="true">↗</span></span>
      </div>
    </div>
  </a>
</article>
