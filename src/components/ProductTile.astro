---
import { Image } from 'astro:assets';
import { productUrl, type Product } from '../lib/shop';
import { formatPrice } from '../lib/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { category, images: [cover], name, priceCents, status, summary } = product.data;
---

<article class="product-tile">
  <a href={productUrl(product)} class="tile-link">
    <Image
      src={cover.src}
      alt={cover.alt}
      width={Math.min(cover.src.width, 900)}
      widths={[300, 600, 900]}
      sizes="(min-width: 58rem) 30vw, (min-width: 42rem) 46vw, 92vw"
      format="webp"
      class="tile-image"
    />
    <div class="tile-copy">
      <p class="eyebrow">{category}</p>
      <h3 class="tile-title">{name}</h3>
      <p class="text-copy">{summary}</p>
      <p class:list={['tile-price', status === 'coming_soon' && 'status-label']}>{status === 'coming_soon' ? 'Em breve' : formatPrice(priceCents)}</p>
    </div>
  </a>
</article>
